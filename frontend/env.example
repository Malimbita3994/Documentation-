# Knowledge Base API Keys
# Copy this file to .env and add your actual API keys

# IEEE Xplore API (for IEEE Standards)
VITE_IEEE_API_KEY=your_ieee_api_key_here

# GitHub API (for GitHub repositories and documentation)
VITE_GITHUB_TOKEN=your_github_token_here

# Stack Overflow API (optional - has rate limits)
VITE_STACKOVERFLOW_KEY=your_stackoverflow_key_here

# arXiv API (free, no key required)
# No key needed for arXiv

# Wikipedia API (free, no key required)
# No key needed for Wikipedia

# ISO Standards API (may require subscription)
VITE_ISO_API_KEY=your_iso_api_key_here

# NIST API (free, no key required)
# No key needed for NIST

# OWASP API (free, no key required)
# No key needed for OWASP

# Backend API URL (for local development)
VITE_API_URL=http://localhost:8000/api

# Frontend URL (for local development)
VITE_FRONTEND_URL=http://localhost:3000

# Environment
VITE_ENV=development
